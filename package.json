{
  "name": "kaynak",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kaynak/web dev",
    "dev:worker": "pnpm --filter @kaynak/worker dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:agents": "vitest run --project agents",
    "db:generate": "pnpm --filter @kaynak/db generate",
    "db:migrate": "pnpm --filter @kaynak/db migrate",
    "db:seed": "pnpm --filter @kaynak/db seed",
    "pipeline:run": "pnpm --filter @kaynak/pipeline run-cli",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "pnpm --filter @kaynak/web e2e",
    "eval:agents": "pnpm --filter @kaynak/agents eval",
    "rehearsal": "pnpm --filter @kaynak/pipeline rehearsal"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.43.0",
    "@eslint/js": "^9.35.0",
    "globals": "^16.3.0"
  },
  "type": "module"
}
