# Otomatik HTTPS (Let's Encrypt). DOMAIN ve ACME_EMAIL .env'den gelir.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format console
	}
}
