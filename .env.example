# --- Veri katmanı ---
# Yerel geliştirme: gömülü Postgres (PGlite), dosyaya yazar. Docker yoksa bunu kullan.
DATABASE_URL=pglite://./data/kaynak
# Üretim / Docker Compose:
# DATABASE_URL=postgres://kaynak:kaynak@localhost:5432/kaynak
# Boş bırakılırsa worker BullMQ yerine süreç içi çalıştırıcı kullanır (pipeline:run CLI).
REDIS_URL=

# --- Ajanlar ---
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-4-5
MODEL_WRITE=claude-sonnet-5
REVIEW_THRESHOLD=4        # importance >= bu değer insan onayı ister
# Flaş: bu kaynaklarda önem >= FLASH_MIN_IMPORTANCE olan belgeden tek cümlelik haber saniyeler içinde yayımlanır (onay beklemez;
# sayı + yasaklı kalıp kontrolü şart). Tam metin aynı adresi günceller; onay gerekiyorsa editör onaylayınca flaşın yerine geçer. Kapatmak: boş bırak.
FLASH_SOURCES=tcmb,tuik,kap
FLASH_MIN_IMPORTANCE=4

# --- Site ---
SITE_URL=http://localhost:3000
BOT_CONTACT_EMAIL=iletisim@example.com
REVALIDATE_SECRET=change-me   # worker -> web /api/revalidate çağrısı için paylaşılan sır

# --- Dağıtım (Faz 3) ---
# Web push: anahtar çifti üret → npx web-push generate-vapid-keys ; boşsa push kapalı (istemci kutuyu göstermez)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto:iletisim@... (boşsa BOT_CONTACT_EMAIL kullanılır)
PUSH_MIN_IMPORTANCE=4          # importance >= bu değer push gönderir (şartname §5.5)
TELEGRAM_BOT_TOKEN=            # boşsa Telegram atlanır
TELEGRAM_CHANNEL_ID=           # @kanaladi ya da -100...
# Sabah bülteni: SMTP_URL boşsa e-postalar MAIL_DIR altına .eml olarak yazılır (geliştirme)
SMTP_URL=                      # smtp://kullanici:parola@smtp.example.com:587
MAIL_FROM=Kaynak <bulten@example.com>
MAIL_DIR=./storage/mail
BULLETIN_TIME=07:30            # Türkiye saati
BULLETIN_SPONSOR_NAME=         # üçü de doluysa bültenin üstünde "Sponsorlu" bloğu
BULLETIN_SPONSOR_TEXT=
BULLETIN_SPONSOR_URL=
INDEXNOW_KEY=
EVDS_API_KEY=                  # TCMB EVDS anahtarı → piyasa şeridi (USD/EUR/GBP gösterge kuru, 30 dk); boşsa şerit gizli

# --- Belge deposu: S3_BUCKET + anahtarlar tanımlıysa S3/MinIO (S3_ENDPOINT verilirse path-style), yoksa ./storage ---
S3_ENDPOINT=                   # http://localhost:9000 (MinIO) — AWS S3 için boş bırak
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PREFIX=                     # isteğe bağlı anahtar ön eki (ör. kaynak/)

# --- Admin (Faz 4) ---
# Parola boş ya da "change-me" ise /admin kapalıdır (503). Basic Auth; HTTPS arkasında kullanın.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Künye (Basın Kanunu; /kunye ve /kvkk sayfalarında görünür) ---
PUBLISHER_NAME=                          # sahibi: şirket varsa ticari unvan, yoksa ad soyad (gerçek kişi)
PUBLISHER_ADDRESS=
PUBLISHER_EMAIL=
PUBLISHER_PHONE=
PUBLISHER_UETS=                          # elektronik tebligat adresi (PTT UETS; e-Devlet → Elektronik Tebligat Adresi Başvurusu)
HOSTING_PROVIDER=
HOSTING_ADDRESS=                         # yer sağlayıcının adresi (kanun adını ve adresini ister)
RESPONSIBLE_EDITOR=

# --- Kaynak siteleri ---
# TCMB besleme, TÜİK veri portalı ve takvim adresleri (varsayılanlar packages/sources içinde; portal değişirse buradan ez)
TCMB_FEED_URL=
TUIK_BASE_URL=
TCMB_CALENDAR_URL=
TUIK_CALENDAR_URL=
# Faz 4+ liste adapter'ları (varsayılanlar packages/sources/src/listing/configs.ts; açmak için: pnpm db:seed -- --enable spk)
SPK_LIST_URL=
BDDK_LIST_URL=
EPDK_LIST_URL=
BOTAS_LIST_URL=
# KAP: worker'ın taraması `sources.enabled` ile açılır (kullanım koşulları onaylandıktan sonra): pnpm db:seed -- --enable kap
# resmigazete.gov.tr sertifika zinciri TÜBİTAK Kamu SM köküne dayanır; Node'un varsayılan
# deposunda yoktur. Kök sertifikayı indirip yolunu ver (Node bunu başlangıçta okur):
# NODE_EXTRA_CA_CERTS=./certs/kamusm-root.pem

# --- Reklam (Faz 5) — NEXT_PUBLIC_* derleme anında istemciye gömülür ---
# Sağlayıcı: none | adsense | gam. Rıza ("Kabul et") öncesi hiçbir reklam scripti yüklenmez; slotlar sabit boyutludur (CLS).
NEXT_PUBLIC_AD_PROVIDER=none
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GAM_NETWORK=               # /1234567/kaynak
NEXT_PUBLIC_AD_UNITS=                  # {"home-top":"1234567890","article-top":"…","article-inline":"…","home-rail":"…","article-rail":"…","company-rail":"…","tabbar-top":"…"}
ADS_TXT=                               # google.com, pub-XXXX, DIRECT, f08c47fec0942fa0 | ikinci satır…
AD_SALES_EMAIL=                        # /reklam formu bildirimleri (boşsa PUBLISHER_EMAIL)

# --- X paylaşımı (Faz 5) — yalnızca resmi hesap; günde en fazla 30 gönderi (şartname §8) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_MAX_PER_DAY=30
X_MIN_IMPORTANCE=3                     # bu önem ve üstü paylaşılır (kota düşük önemli haberlere gitmesin)

# --- Kategori sponsorluğu ve CSP ---
CATEGORY_SPONSORS=             # {"borsa":{"name":"…","text":"…","url":"https://…"}} — kategori sayfasında "Sponsorlu" kartı
CSP_ENFORCE=                   # 1 → Content-Security-Policy zorlanır (varsayılan Report-Only; ihlaller /api/csp-report'a ve sunucu günlüğüne düşer)
CSP_DISABLE=                   # 1 → CSP başlığı hiç eklenmez

# --- Dağıtım (deploy/docker-compose.prod.yml; bkz. docs/DAGITIM.md) ---
# deploy/setup-vps.sh bunları doldurur; sırlar boşsa otomatik üretilir.
DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

# --- Kaynak alarmları (bkz. docs/DAGITIM.md §8) ---
# Bir kaynağın yapısı değişirse ya da sessiz kalırsa uyarı gider. İkisi de boşsa yalnızca /api/health/sources ve admin paneli gösterir.
ALERT_EMAIL=
ALERT_TELEGRAM_CHAT_ID=
