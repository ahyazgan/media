# --- Veri katmanı ---
# Yerel geliştirme: gömülü Postgres (PGlite), dosyaya yazar. Docker yoksa bunu kullan.
DATABASE_URL=pglite://./data/kaynak
# Üretim / Docker Compose:
# DATABASE_URL=postgres://kaynak:kaynak@localhost:5432/kaynak
# Boş bırakılırsa worker BullMQ yerine süreç içi çalıştırıcı kullanır (pipeline:run CLI).
REDIS_URL=

# --- Ajanlar ---
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-4-5
MODEL_WRITE=claude-sonnet-5
REVIEW_THRESHOLD=4        # importance >= bu değer insan onayı ister

# --- Site ---
SITE_URL=http://localhost:3000
BOT_CONTACT_EMAIL=iletisim@example.com
REVALIDATE_SECRET=change-me   # worker -> web /api/revalidate çağrısı için paylaşılan sır

# --- Dağıtım (Faz 3) ---
# Web push: anahtar çifti üret → npx web-push generate-vapid-keys ; boşsa push kapalı (istemci kutuyu göstermez)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto:iletisim@... (boşsa BOT_CONTACT_EMAIL kullanılır)
PUSH_MIN_IMPORTANCE=4          # importance >= bu değer push gönderir (şartname §5.5)
TELEGRAM_BOT_TOKEN=            # boşsa Telegram atlanır
TELEGRAM_CHANNEL_ID=           # @kanaladi ya da -100...
# Sabah bülteni: SMTP_URL boşsa e-postalar MAIL_DIR altına .eml olarak yazılır (geliştirme)
SMTP_URL=                      # smtp://kullanici:parola@smtp.example.com:587
MAIL_FROM=Kaynak <bulten@example.com>
MAIL_DIR=./storage/mail
BULLETIN_TIME=07:30            # Türkiye saati
INDEXNOW_KEY=
EVDS_API_KEY=

# --- Belge deposu (boşsa ./storage altına yazar) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Admin (Faz 4) ---
# Parola boş ya da "change-me" ise /admin kapalıdır (503). Basic Auth; HTTPS arkasında kullanın.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Künye (Basın Kanunu; /kunye ve /kvkk sayfalarında görünür) ---
PUBLISHER_NAME=
PUBLISHER_ADDRESS=
PUBLISHER_EMAIL=
PUBLISHER_PHONE=
HOSTING_PROVIDER=
RESPONSIBLE_EDITOR=

# --- Kaynak siteleri ---
# TCMB/TÜİK besleme ve takvim adresleri (varsayılanlar packages/sources içinde; portal değişirse buradan ez)
TCMB_FEED_URL=
TUIK_FEED_URL=
TCMB_CALENDAR_URL=
TUIK_CALENDAR_URL=
# KAP: worker'ın taraması `sources.enabled` ile açılır (kullanım koşulları onaylandıktan sonra): pnpm db:seed -- --enable kap
# resmigazete.gov.tr sertifika zinciri TÜBİTAK Kamu SM köküne dayanır; Node'un varsayılan
# deposunda yoktur. Kök sertifikayı indirip yolunu ver (Node bunu başlangıçta okur):
# NODE_EXTRA_CA_CERTS=./certs/kamusm-root.pem

# --- Reklam (Faz 5) — NEXT_PUBLIC_* derleme anında istemciye gömülür ---
# Sağlayıcı: none | adsense | gam. Rıza ("Kabul et") öncesi hiçbir reklam scripti yüklenmez; slotlar sabit boyutludur (CLS).
NEXT_PUBLIC_AD_PROVIDER=none
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GAM_NETWORK=               # /1234567/kaynak
NEXT_PUBLIC_AD_UNITS=                  # {"home-top":"1234567890","article-top":"…","article-inline":"…","home-rail":"…","article-rail":"…","company-rail":"…","tabbar-top":"…"}
ADS_TXT=                               # google.com, pub-XXXX, DIRECT, f08c47fec0942fa0 | ikinci satır…
AD_SALES_EMAIL=                        # /reklam formu bildirimleri (boşsa PUBLISHER_EMAIL)

# --- X paylaşımı (Faz 5) — yalnızca resmi hesap; günde en fazla 30 gönderi (şartname §8) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_MAX_PER_DAY=30
X_MIN_IMPORTANCE=3                     # bu önem ve üstü paylaşılır (kota düşük önemli haberlere gitmesin)
